{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "worker-configuration.d.ts"],
  // Tests run with the app's Vitest, in Node.
  "exclude": ["src/**/*.test.ts"]
}
